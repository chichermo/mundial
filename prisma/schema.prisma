generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String       @id @default(cuid())
  email                String       @unique
  passwordHash         String
  displayName          String
  notifyMatchReminders Boolean      @default(true)
  onboardingDone       Boolean      @default(false)
  favoriteTeams        String       @default("[]")
  createdAt            DateTime     @default(now())
  ownedGroups          PollaGroup[] @relation("GroupOwner")
  memberships          Member[]
}

model PollaGroup {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  ownerId   String?
  owner     User?    @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  members   Member[]
}

model Member {
  id                  String               @id @default(cuid())
  name                String
  userId              String?
  user                User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId             String
  group               PollaGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  matchPredictions    MatchPrediction[]
  knockoutPredictions KnockoutPrediction[]
  tournamentPick      TournamentPick?
  matchComments       MatchComment[]

  @@unique([groupId, userId])
}

model MatchPrediction {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  matchId   Int
  homeScore Int
  awayScore Int
  updatedAt DateTime @updatedAt

  @@unique([memberId, matchId])
}

model KnockoutPrediction {
  id          String @id @default(cuid())
  memberId    String
  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  matchId     Int
  winnerLabel String

  @@unique([memberId, matchId])
}

model TournamentPick {
  id               String   @id @default(cuid())
  memberId         String   @unique
  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  champion         String?
  surprise         String?
  revelationTeam   String?
  topScorer        String?
  revelationPlayer String?
  updatedAt        DateTime @updatedAt
}

model MatchResult {
  matchId     Int      @id
  homeScore   Int?
  awayScore   Int?
  winnerLabel String?
  updatedAt   DateTime @updatedAt
}

model GlobalAnswers {
  id               String   @id @default("global")
  champion         String?
  surprise         String?
  revelationTeam   String?
  topScorer        String?
  revelationPlayer String?
  updatedAt        DateTime @updatedAt
}

model MatchComment {
  id        String   @id @default(cuid())
  matchId   Int
  groupId   String
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model AdminChangeLog {
  id        String   @id @default(cuid())
  action    String
  detail    String
  createdAt DateTime @default(now())
}

model AppConfig {
  id                 String   @id @default("global")
  featuredMatchId    Int?
  featuredMultiplier Int      @default(2)
  updatedAt          DateTime @updatedAt
}
