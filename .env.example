DATABASE_URL="file:./dev.db"
ADMIN_PASSWORD="cambia-esta-clave"

# Grupo único de la polla (Vercel: configurar en Environment Variables)
POLL_GROUP_NAME="Balsuos"
POLL_GROUP_CODE="BALSUO"
POLL_MAX_MEMBERS=8
POLL_QUALIFIERS=4

# openfootball — sync de resultados (sin clave; opcional URL custom)
# OPENFOOTBALL_URL="https://raw.githubusercontent.com/openfootball/worldcup.json/master/2026/worldcup.json"

# API-Football (opcional, si el plan incluye Mundial 2026)
API_FOOTBALL_KEY=""

# Secreto para cron Vercel (GET /api/cron/sync-results con Authorization: Bearer ...)
CRON_SECRET=""

# Turso (Vercel producción) — también para npm run db:push:turso
# TURSO_DATABASE_URL="libsql://tu-db.turso.io"
# TURSO_AUTH_TOKEN="tu-token"
